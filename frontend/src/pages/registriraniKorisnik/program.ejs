<%- include('head', { naslov: 'Program konferencije' }) %>
<%- include('sidebar', { aktivno: 'program' }) %>

<header class="page-header">
  <h1>Program konferencije</h1>
  <p>Sekcije, dvorane, termini i izlaganja.</p>
</header>

<section class="card">
  <div class="card-head">
    <h3>Raspored po sekcijama</h3>
  </div>

  <% if (sekcije.length === 0) { %>
    <p>Program će biti objavljen nakon odluke programskog odbora.</p>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>Sekcija</th>
            <th>Dvorana</th>
            <th>Termin</th>
            <th>Predsjedavajući</th>
          </tr>
        </thead>
        <tbody>
          <% sekcije.forEach(s => { %>
            <tr>
              <td><%= s.naziv %></td>
              <td><%= s.dvorana %></td>
              <td><%= s.termin %></td>
              <td><%= s.predsjedavajuci %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<%- include('footer') %>