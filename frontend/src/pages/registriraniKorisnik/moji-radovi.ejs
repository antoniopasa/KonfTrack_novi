<%- include('head', { naslov: 'Moji radovi' }) %>
<%- include('sidebar', { aktivno: 'radovi' }) %>

<header class="page-header">
  <h1>Moji radovi</h1>
  <p>Pregled predanih radova i njihovih stanja.</p>
</header>

<section class="card">
  <div class="card-head">
    <h3>Predani radovi</h3>
    <div class="filters">
      <input type="text" placeholder="Pretraži..." disabled>
      <select disabled>
        <option>Sva stanja</option>
      </select>
    </div>
  </div>

  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th>Naslov</th>
          <th>Konferencija</th>
          <th>Tema</th>
          <th>Datum predaje</th>
          <th>Stanje</th>
          <th></th>
        </tr>
      </thead>
       <tbody id="radoviTijelo"></tbody>
    </table>
  </div>
</section>
<script src="/registriraniKorisnik/moji-radovi.js" defer></script>
<%- include('footer') %>
