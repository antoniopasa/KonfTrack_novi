<%- include('head', { naslov: 'Predaja rada' }) %>
<%- include('sidebar', { aktivno: 'predaja' }) %>

<header class="page-header">
  <h1>Predaja rada</h1>
  <p>Ispunite podatke o radu i priložite anonimizirani rukopis.</p>
</header>


<form class="card form" id="predajaForm"
      data-ime="<%= korisnik.ime %> <%= korisnik.prezime %>"
      data-email="<%= korisnik.email %>">
  <fieldset>
    <div class="form-grid">
            <div class="field full">
        <label for="konferencija">Konferencija</label>
        <select id="konferencija">
          <option value="">Učitavanje konferencija…</option>
        </select>
        <small id="konf-info" class="muted"></small>
      </div>
      <div class="field full">
        <label for="naslov">Naslov rada</label>
        <input id="naslov" type="text" placeholder="Unesite naslov rada">
      </div>

      <div class="field full">
        <label for="sazetak">Sažetak</label>
        <textarea id="sazetak" rows="5" placeholder="Kratak sažetak rada"></textarea>
      </div>

      <div class="field">
        <label for="tema">Tema</label>
                <select id="tema" disabled>
          <option value="">Najprije odaberite konferenciju</option>
        </select>
      </div>

      <div class="field">
        <label for="kljucne">Ključne riječi</label>
        <input id="kljucne" type="text" placeholder="npr. strojno učenje, obrada signala">
      </div>

      <div class="field full">
        <label>Koautori</label>
          <div class="coauthor-row">
          <input id="koautor-ime" type="text" placeholder="Ime i prezime">
          <input id="koautor-email" type="email" placeholder="E-pošta">
          <button type="button" id="dodajKoautora" class="btn btn-secondary">Dodaj</button>
        </div>
        <div id="popisKoautora"></div>
      </div>

      <div class="field full">
        <label for="reference">Reference s DOI oznakom (jedna po retku)</label>
        <textarea id="reference" rows="3" placeholder="npr. 10.1038/nature14539"></textarea>
      </div>

      <div class="field">
        <label for="kontakt">Autor za kontakt</label>
          <select id="kontakt"></select>
      </div>

      <div class="field">
        <label for="rukopis">Rukopis (PDF, anonimiziran)</label>
        <label class="dropzone" for="rukopis">
          <input id="rukopis" type="file" accept="application/pdf" hidden>
          <span>Odaberite ili povucite PDF datoteku</span>
        </label>
      </div>
    </div>

    <div class="form-actions">
      <button type="button" id="spremiNacrt" class="btn btn-secondary">Spremi nacrt</button>
      <button type="submit" class="btn btn-primary">Predaj rad</button>
    </div>
  </fieldset>
</form>

<div id="rezultat"></div>

<script src="/registriraniKorisnik/predaja.js" defer></script>
<%- include('footer') %>