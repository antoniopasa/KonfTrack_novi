



' ==============================================================================
' 3-1-konftrack-system-UC_v1.puml
'
' Svrha:    Prikazuje glavne aktere i ciljeve korištenja sustava KonfTrack te
'           vanjske sustave s kojima KonfTrack komunicira. Detaljni prikazi nalaze se u zasebnim usmjerenim dijagramima.
' Autor:    [Pavla Čančar]
' AI:       AI je pomogao reviziji dijagrama koji je izradio autor te u usklađivanju izgleda koda s predloškom koji nam je zadan kao primejr;autor je pregledao
'           sadržaj i odgovara za konačni sadržaj.
' Zahtjevi: F-001 do F-070
'
' Diagram level: System Requirements
' Diagram type:  Use Case Diagram
' Version:       1.1
' ==============================================================================

@startuml
title Sustav KonfTrack – slučajevi uporabe
left to right direction

skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #212529

skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #212529
    BackgroundColor<<external system>> #FFF3CD
    BorderColor<<external system>> #856404
}

skinparam usecase {
    BackgroundColor #E7F1FF
    BorderColor #0D6EFD
}

' ==============================================================================
' Primarni akteri
' ==============================================================================

actor "Neregistrirani korisnik" as Visitor
actor "Registrirani korisnik" as User
actor "Administrator sustava" as Admin
actor "Predsjednik programskog\nodbora" as Chair
actor Autor as Author
actor Recenzent as Reviewer

' Autor, recenzent, administrator i predsjednik programskog odbora
' specijalizacije su registriranog korisnika. Ista osoba može imati
' različite uloge na različitim konferencijama.

Admin -|> User
Chair -|> User
Author -|> User
Reviewer -|> User

' Samo za raspored aktera.
Admin -[hidden]down-> Chair
Chair -[hidden]down-> Author
Author -[hidden]down-> Reviewer
Visitor -[hidden]down-> User

' ==============================================================================
' Sekundarni akteri (vanjski sustavi)
' ==============================================================================

actor ORCID <<external system>>
actor Crossref <<external system>>
actor "Google Calendar" as GoogleCalendar <<external system>>

' ==============================================================================
' Granica sustava
' ==============================================================================

rectangle "Sustav KonfTrack" as KonfTrack {

    ' Pristup i korisnički račun
    (UC-01\nRegistracija) as UC_Register
    (UC-02\nPrijava u sustav) as UC_Login
    (UC-23\nOdjava iz sustava) as UC_Logout
    (UC-03\nPregled javne stranice\nkonferencije) as UC_PublicPage
    (UC-04\nUpravljanje profilom) as UC_Profile

    ' Administracija i upravljanje konferencijom
    (UC-05\nUpravljanje korisnicima i\npostavkama platforme) as UC_Admin
    (UC-06\nOdobravanje konferencije\ni imenovanje predsjednika) as UC_Approve
    (UC-07\nUpravljanje konferencijom) as UC_Conference

    ' Upravljanje radovima
    (UC-08\nPredaja rada) as UC_Submit
    (UC-09\nUpravljanje vlastitim radovima) as UC_MyPapers

    ' Upravljanje recenziranjem
    (UC-10\nUpravljanje recenzentima) as UC_Reviewers
    (UC-11\nPrihvaćanje ili odbijanje\npoziva za recenziranje) as UC_Invitation
    (UC-12\nIskazivanje interesa\nza recenziranje) as UC_Interest
    (UC-13\nDodjela radova\nrecenzentima) as UC_Assignment
    (UC-14\nRecenziranje rada) as UC_Review
    (UC-15\nSudjelovanje u\nanonimnoj raspravi) as UC_Discussion

    ' Odluke i statistika
    (UC-16\nDonošenje odluka\no radovima) as UC_Decisions
    (UC-17\nPregled statistike\nkonferencije) as UC_Statistics

    ' Program konferencije i osobni raspored
    (UC-18\nUpravljanje programom\nkonferencije) as UC_Program
    (UC-19\nUpravljanje osobnim\nrasporedom) as UC_Schedule
    (UC-20\nGeneriranje zbornika\nradova) as UC_Proceedings

    ' Uključeni slučajevi uporabe
    (UC-21\nProvjera DOI referenci) as UC_DOI
    (UC-22\nProvjera sukoba interesa) as UC_Conflict
}

' ==============================================================================
' Asocijacije aktera i slučajeva uporabe
' ==============================================================================

' Neregistrirani korisnik
Visitor -- UC_Register
Visitor -- UC_PublicPage

' Registrirani korisnik
User -- UC_Login
User -- UC_PublicPage
User -- UC_Profile
User -- UC_Schedule
User -- UC_Logout

' Administrator sustava
Admin -- UC_Admin
Admin -- UC_Approve

' Predsjednik programskog odbora
Chair -- UC_Conference
Chair -- UC_Reviewers
Chair -- UC_Assignment
Chair -- UC_Decisions
Chair -- UC_Program
Chair -- UC_Statistics

' Autor
Author -- UC_Submit
Author -- UC_MyPapers

' Recenzent
Reviewer -- UC_Invitation
Reviewer -- UC_Interest
Reviewer -- UC_Review
Reviewer -- UC_Discussion

' ==============================================================================
' Veze između slučajeva uporabe
' ==============================================================================

' Provjera DOI referenci provodi se pri predaji rada ako rad sadrži DOI reference.
UC_Submit ..> UC_DOI : <<include>>

' Provjera sukoba interesa sastavni je dio dodjele radova recenzentima.
UC_Assignment ..> UC_Conflict : <<include>>

' ==============================================================================
' Interakcije s vanjskim sustavima
' ==============================================================================

' ORCID se koristi za registraciju, prijavu i provjeru podataka relevantnih
' za sukob interesa.
UC_Register -right- ORCID
UC_Login -- ORCID
UC_Conflict -- ORCID

' Crossref se koristi za provjeru DOI referenci i dohvat metapodataka.
UC_DOI -- Crossref

' Pretpostavlja se izravna integracija s Google Calendarom.
UC_Schedule -- GoogleCalendar

' Samo za raspored vanjskih sustava.
Crossref -[hidden]down-> ORCID
ORCID -[hidden]down-> GoogleCalendar

@enduml