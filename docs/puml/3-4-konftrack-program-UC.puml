
' ==============================================================================
' upravljanje_programom.puml
'
' Svrha:    Prikazuje slučajeve uporabe povezane sa sastavljanjem i objavom
'           programa konferencije, upravljanjem osobnim rasporedom i
'           generiranjem zbornika.
' Autor:    Pavla Čančar
' AI:       AI je pomogao u strukturiranju i reviziji dijagrama;
'           autorica ga je pregledala i odgovara za konačni sadržaj.
' Zahtjevi: UC-10.1 do UC-10.6, UC-11.1 i UC-12.1
'           (F-022 do F-024)
'
' Diagram level: System Requirements
' Diagram type:  Use Case Diagram
' Version:       2.2
' ==============================================================================

@startuml
title Sustav KonfTrack – upravljanje programom
left to right direction

skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #212529
skinparam nodesep 25
skinparam ranksep 30
skinparam packageStyle rectangle

skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #212529
    BackgroundColor<<external system>> #FFF3CD
    BorderColor<<external system>> #856404
}

skinparam usecase {
    BackgroundColor #E7F1FF
    BorderColor #0D6EFD
}

' ==============================================================================
' Primarni akteri
' ==============================================================================

actor Chair as "Predsjednik programskog\nodbora"
actor User as "Registrirani korisnik"
actor Visitor as "Neregistrirani korisnik"

' ==============================================================================
' Sekundarni akteri (vanjski sustavi)
' ==============================================================================

actor Calendar as "Google Calendar" <<external system>>

' ==============================================================================
' Granica sustava
' ==============================================================================

rectangle "Sustav KonfTrack – upravljanje programom" {

    ' Sastavljanje i objava programa
    package "1. Sastavljanje i objava programa" {
        (UC-10.1\nUređivanje programa konferencije) as UC_101

        (UC-10.2\nUpravljanje sekcijama\n==\nTema, dvorana, termin i predsjedavajući) as UC_102

        (UC-10.3\nUvrštavanje radova i raspoređivanje izlaganja) as UC_103

        (UC-10.4\nProvjera ograničenja programa\n==\nPreklapanje izlagača i predsjedavajući nije autor) as UC_104

        (UC-10.5\nObjava programa konferencije) as UC_105

        (UC-10.6\nPregled javnog programa konferencije) as UC_106
    }

    ' Osobni raspored
    package "2. Osobni raspored" {
        (UC-11.1\nUpravljanje osobnim rasporedom) as UC_111
    }

    ' Zbornik
    package "3. Zbornik" {
        (UC-12.1\nGeneriranje PDF zbornika sažetaka) as UC_121
    }

    ' Raspored paketa u dva reda
    UC_106 -[hidden]right- UC_111
    UC_111 -[hidden]right- UC_121
}

' ==============================================================================
' Asocijacije aktera i slučajeva uporabe
' ==============================================================================

' Predsjednik programskog odbora upravlja programom i zbornikom.
Chair -- UC_101
Chair -- UC_102
Chair -- UC_103
Chair -- UC_104
Chair -- UC_105
Chair -- UC_121

' Registrirani i neregistrirani korisnici pregledavaju javni program.
Visitor -- UC_106
User -- UC_106

' Registrirani korisnik upravlja osobnim rasporedom.
User -- UC_111

' Vanjski sustav povezan je s upravljanjem osobnim rasporedom.
Calendar -- UC_111

' ==============================================================================
' Veze između slučajeva uporabe
' ==============================================================================

' Provjera ograničenja obvezan je dio uvrštavanja radova u program.
UC_103 ..> UC_104 : <<include>>

' ==============================================================================
' Raspored aktera
' ==============================================================================

' Akteri se smještaju na desnu stranu sustava.
UC_106 -[hidden]right- User
User -[hidden]down- Visitor
Visitor -[hidden]down- UC_111
UC_111 -[hidden]right- Calendar

@enduml
