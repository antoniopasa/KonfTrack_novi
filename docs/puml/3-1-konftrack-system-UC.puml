
' ==============================================================================
' 3-1-konftrack-system-UC_v1.puml
'
' Svrha:    Prikazuje tko i s kojim ciljem koristi sustav KonfTrack
'           (korisnici, administratori, predsjednici programskog odbora,
'           autori i recenzenti) te koje vanjske sustave sustav koristi.
'           Interna logika, pohrana podataka i korisničko sučelje
'           namjerno nisu obuhvaćeni (kasniji modeli).
'
' Autor:    Tim KonfTrack, kolegij Programsko inženjerstvo
' AI:       AI je pomogao u strukturiranju i reviziji dijagrama;
'           autori su pregledali i odgovaraju za konačni sadržaj.
' Zahtjevi: UC-01 do UC-13 (svaki slučaj uporabe ima ID za praćenje
'           prema funkcijskim zahtjevima, implementaciji i testovima)
'
' Diagram level: System Requirements
' Diagram type:  Use Case Diagram
' Version:       1.0
' ==============================================================================

@startuml
title Sustav KonfTrack – slučajevi uporabe
left to right direction

skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #212529

skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #212529
    BackgroundColor<<external system>> #FFF3CD
    BorderColor<<external system>> #856404
}

skinparam usecase {
    BackgroundColor #E7F1FF
    BorderColor #0D6EFD
}

' ==============================================================================
' Primarni akteri
' ==============================================================================

' Akteri predstavljaju korisničke uloge, a ne stanja prijave.
' Specijalizirane uloge nasljeđuju mogućnosti registriranog korisnika.

actor User as "Registrirani korisnik"
actor Visitor as "Neregistrirani korisnik"
actor Admin as "Administrator sustava"
actor Chair as "Predsjednik programskog\nodbora"
actor Author as "Autor"
actor Reviewer as "Recenzent"

Admin -|> User
Chair -|> User
Author -|> User
Reviewer -|> User

' Samo za raspored aktera na dijagramu.
Admin -[hidden]down-> Chair
Chair -[hidden]down-> Author
Author -[hidden]down-> Reviewer

' ==============================================================================
' Sekundarni akteri (vanjski sustavi)
' ==============================================================================

actor ORCID <<external system>>
actor Crossref <<external system>>
actor "Google Calendar" as Calendar <<external system>>

' ==============================================================================
' Granica sustava
' ==============================================================================

rectangle "Sustav KonfTrack" as KonfTrack {

    ' Korisnički računi i administracija
    (UC-01\nUpravljanje računom\ni profilom) as UC_Account
    (UC-02\nAdministriranje korisnika\ni ovlasti) as UC_Administration
    (UC-03\nOdobravanje konferencije) as UC_Approval

    ' Upravljanje konferencijom i javne informacije
    (UC-04\nUpravljanje konferencijom) as UC_Conference
    (UC-05\nPregled i objava\njavnih informacija) as UC_PublicInfo

    ' Radovi
    (UC-06\nPredaja i upravljanje radovima) as UC_Papers

    ' Recenzenti i recenziranje
    (UC-07\nUpravljanje recenzentima\ni dodjelom radova) as UC_Reviewers
    (UC-08\nRecenziranje i rasprava\no radovima) as UC_Review
    (UC-09\nDonošenje odluka i\nobavještavanje autora) as UC_Decisions

    ' Program i osobni raspored
    (UC-10\nUpravljanje programom konferencije) as UC_Program
    (UC-11\nUpravljanje osobnim rasporedom) as UC_Schedule

    ' Zbornik i statistika
    (UC-12\nGeneriranje zbornika) as UC_Proceedings
    (UC-13\nUpravljanje statistikom i\npostavkama platforme) as UC_Statistics
}

' ==============================================================================
' Asocijacije aktera i slučajeva uporabe
' ==============================================================================

' Registrirani korisnik
User -- UC_Account
User -- UC_PublicInfo
User -- UC_Schedule

' Neregistrirani korisnik
Visitor -- UC_PublicInfo

' Administrator sustava
Admin -- UC_Administration
Admin -- UC_Approval
Admin -- UC_Statistics

' Predsjednik programskog odbora
Chair -- UC_Conference
Chair -- UC_PublicInfo
Chair -- UC_Reviewers
Chair -- UC_Decisions
Chair -- UC_Program
Chair -- UC_Proceedings
Chair -- UC_Statistics

' Autor
Author -- UC_Papers
Author -- UC_Decisions

' Recenzent
Reviewer -- UC_Reviewers
Reviewer -- UC_Review

' ==============================================================================
' Veze između slučajeva uporabe
' ==============================================================================

' Nema zasebnih pomoćnih slučajeva uporabe za DOI provjeru,
' provjeru sukoba interesa ili slanje obavijesti jer su ti postupci
' sastavni dijelovi odgovarajućih glavnih slučajeva uporabe.

' ==============================================================================
' Interakcije sa sekundarnim akterima
' ==============================================================================

' ORCID se koristi za autentifikaciju i provjeru povezanih podataka.
UC_Account -- ORCID
UC_Reviewers -- ORCID

' Crossref se koristi za provjeru DOI identifikatora radova.
UC_Papers -- Crossref

' Google Calendar služi za povezivanje osobnog rasporeda.
UC_Schedule -- Calendar

' Samo za raspored vanjskih sustava.
ORCID -[hidden]down-> Crossref
Crossref -[hidden]down-> Calendar

@enduml

