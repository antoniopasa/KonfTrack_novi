
' ==============================================================================
' upravljanje_radovima.puml
'
' Svrha:    Prikazuje slučajeve uporabe povezane s pripremom i predajom
'           znanstvenih radova, upravljanjem predanim radovima te predajom
'           revidiranih i konačnih verzija.
' Autor:    Pavla Čančar
' AI:       AI je pomogao u strukturiranju i reviziji dijagrama;
'           autorica ga je pregledala i odgovara za konačni sadržaj.
' Zahtjevi: UC-06.1 do UC-06.8 (F-008 do F-012)
'
' Diagram level: System Requirements
' Diagram type:  Use Case Diagram
' Version:       2.4
' ==============================================================================

@startuml
title Sustav KonfTrack – upravljanje radovima
left to right direction

skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #212529
skinparam nodesep 25
skinparam ranksep 30
skinparam packageStyle rectangle

skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #212529
    BackgroundColor<<external system>> #FFF3CD
    BorderColor<<external system>> #856404
}

skinparam usecase {
    BackgroundColor #E7F1FF
    BorderColor #0D6EFD
}

' ==============================================================================
' Primarni akteri
' ==============================================================================

actor Author as "Autor"

' ==============================================================================
' Sekundarni akteri (vanjski sustavi)
' ==============================================================================

actor Crossref as "Crossref" <<external system>>

' ==============================================================================
' Granica sustava
' ==============================================================================

rectangle "Sustav KonfTrack – upravljanje radovima" {

    package "1. Priprema i predaja rada" {
        (UC-06.1\nKreiranje i spremanje nacrta rada) as UC_061

        (UC-06.2\nUnos podataka o radu, autorima i koautorima) as UC_062

        (UC-06.3\nPrilaganje i provjera PDF rukopisa\n==\nFormat, broj stranica i metapodaci) as UC_063

        (UC-06.4\nProvjera DOI referenci) as UC_064

        (UC-06.5\nPredaja rada) as UC_065
    }

    package "2. Upravljanje predanim radom" {
        (UC-06.6\nPregled i praćenje statusa rada) as UC_066

        (UC-06.7\nUređivanje i povlačenje rada\n==\nPovlačenje je moguće prije prihvaćanja) as UC_067

        (UC-06.8\nPredaja revidirane i konačne verzije rada) as UC_068
    }

    ' Raspored paketa u dva vodoravna retka
    UC_061 -[hidden]right- UC_066
    UC_062 -[hidden]right- UC_067
    UC_063 -[hidden]right- UC_068
}

' ==============================================================================
' Asocijacije aktera i slučajeva uporabe
' ==============================================================================

' Autor priprema, predaje i prati svoje radove.
Author -- UC_061
Author -- UC_062
Author -- UC_063
Author -- UC_064
Author -- UC_065
Author -- UC_066
Author -- UC_067
Author -- UC_068

' Vanjski sustav provjerava DOI reference.
UC_064 -- Crossref

' ==============================================================================
' Raspored aktera
' ==============================================================================

' Autor se smješta lijevo, a Crossref desno od sustava.
Author -[hidden]left- UC_061
UC_064 -[hidden]right- Crossref

@enduml

