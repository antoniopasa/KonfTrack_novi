@startumltitle Empty Diagram - 4-4-konftrack-report-submission-SDskinparam shadowing falseskinparam sequenceMessageAlign centerskinparam responseMessageBelowArrow trueskinparam participant {  BackgroundColor #E8F1FB  BorderColor #7BA7D9}skinparam database {  BackgroundColor #E8E8E8  BorderColor #555555}autonumberactor "Autor" as Aparticipant "<<UI>>\nWeb-klijent" as UIparticipant "<<API>>\nAPI za radove" as APIparticipant "<<Application>>\nUsluga za radove" as SVCparticipant "<<Application>>\nProvjera PDF-a" as PDFparticipant "<<External>>\nCrossref" as CRdatabase "<<Persistence>>\nBaza podataka" as DBA -> UI : otvori obrazac za predajuactivate UIA -> UI : unesi podatke, koautore,\nautora za kontakt i PDFA -> UI : Predaj radalt rukopis nije odabran  UI --> A : prikaži "Odaberite PDF datoteku"else rukopis je odabran  UI -> API : POST /api/papers\n(metapodaci, autori, pdfFile)  activate API  alt korisnik nije prijavljen    API --> UI : 401 Unauthorized    UI --> A : preusmjeri na prijavu  else datoteka nije PDF ili je prevelika    API --> UI : 400 Bad Request    UI --> A : prikaži grešku datoteke  else zahtjev je ispravan    API -> SVC : submitPaper(podaci, datoteka)    activate SVC    SVC -> DB : dohvati konferenciju    activate DB    DB --> SVC : konferencija (rok, max. stranica)    deactivate DB    alt nedostaju obavezni podaci, konferencija ne postoji ili je rok istekao      SVC --> API : greška validacije      API --> UI : 400 Bad Request / 404 Not Found      UI --> A : prikaži potrebne ispravke    else podaci su valjani      SVC -> PDF : validatePdf(datoteka, maxStranica, imenaAutora)      activate PDF      alt previše stranica ili neispravan PDF        PDF --> SVC : nevaljan        SVC --> API : greška validacije (datoteka se briše)        API --> UI : 400 Bad Request        UI --> A : prikaži razlog odbijanja      else PDF je valjan        PDF --> SVC : valjan + upozorenja\n(imena autora u metapodacima)        deactivate PDF        loop za svaku navedenu DOI oznaku          SVC -> CR : GET /works/{doi}          activate CR          alt DOI postoji            CR --> SVC : metapodaci reference          else DOI ne postoji ili servis nije dostupan            CR --> SVC : 404 / greška            SVC -> SVC : dodaj upozorenje za DOI          end          deactivate CR        end        SVC -> DB : transakcija: spremi rad (status "submitted"),\nautore i verziju 1 rukopisa        activate DB        alt pohrana je uspjela          DB --> SVC : ID rada          deactivate DB          SVC --> API : rad + upozorenja          API --> UI : 201 Created          UI --> A : prikaži potvrdu i upozorenja,\npreusmjeri na "Moji radovi"        else pohrana nije uspjela          activate DB          DB --> SVC : greška baze          deactivate DB          SVC --> API : greška poslužitelja (datoteka se briše)          API --> UI : 500 Internal Server Error          UI --> A : prikaži neuspjeh i mogućnost\nponovnog pokušaja        end      end    end    deactivate SVC  end  deactivate APIenddeactivate UI@enduml