

' ==============================================================================
' upravljanje_recenziranjem.puml
'
' Svrha:    Prikazuje slučajeve uporabe povezane s pozivanjem recenzenata,
'           provjerom sukoba interesa, dodjelom radova, recenziranjem i
'           raspravom o recenzijama te upravljanjem rokovima.
' Autor:    Pavla Čančar
' AI:       AI je pomogao u strukturiranju i reviziji dijagrama;
'           autorica ga je pregledala i odgovara za konačni sadržaj.
' Zahtjevi: UC-07.1 do UC-07.5 i UC-08.1 do UC-08.3
'           (F-013 do F-019)
'
' Diagram level: System Requirements
' Diagram type:  Use Case Diagram
' Version:       2.2
' ==============================================================================

@startuml

title Sustav KonfTrack - upravljanje recenziranjem i dodjelom radova
left to right direction

skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #212529
skinparam nodesep 25
skinparam ranksep 30
skinparam packageStyle rectangle

skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #212529
    BackgroundColor<<external system>> #FFF3CD
    BorderColor<<external system>> #856404
}

skinparam usecase {
    BackgroundColor #E7F1FF
    BorderColor #0D6EFD
}

' ==============================================================================
' Primarni akteri
' ==============================================================================

actor Chair as "Predsjednik programskog\nodbora"
actor Reviewer as "Recenzent"

' ==============================================================================
' Sekundarni akteri (vanjski sustavi)
' ==============================================================================

actor ORCID as "ORCID" <<external system>>

' ==============================================================================
' Granica sustava
' ==============================================================================

rectangle "Sustav KonfTrack - upravljanje recenziranjem" {

    package "1. Pozivanje i dodjela recenzenata" {
        (UC-07.1\nPozivanje recenzenata i odgovor na poziv) as UC_071

        (UC-07.2\nIskazivanje interesa i prijava sukoba interesa) as UC_072

        (UC-07.3\nProvjera sukoba interesa) as UC_073

        (UC-07.4\nPredlaganje i upravljanje dodjelom radova\n==\nNajmanje 3 recenzenta po radu) as UC_074

        (UC-07.5\nZamjena recenzenata i upravljanje pristupom) as UC_075
    }

    package "2. Recenziranje i rasprava" {
        (UC-08.1\nPregled dodijeljenih radova i predaja recenzije\n==\nDvostruko slijepa recenzija) as UC_081

        (UC-08.2\nPregled recenzija i anonimna rasprava) as UC_082
    }

    package "3. Rokovi recenziranja" {
        (UC-08.3\nUpravljanje rokovima recenziranja) as UC_083
    }

    ' Raspored slučajeva uporabe u dva stupca
    UC_071 -[hidden]right- UC_081
    UC_072 -[hidden]right- UC_082
    UC_073 -[hidden]right- UC_083
}

' ==============================================================================
' Asocijacije aktera i slučajeva uporabe
' ==============================================================================

' Predsjednik programskog odbora upravlja pozivima, dodjelom i rokovima.
Chair -- UC_071
Chair -- UC_074
Chair -- UC_075
Chair -- UC_083

' Recenzent sudjeluje u pozivima, iskazuje interes i recenzira radove.
Reviewer -- UC_071
Reviewer -- UC_072
Reviewer -- UC_081
Reviewer -- UC_082

' ORCID omogućuje automatsku provjeru sukoba interesa.
ORCID -- UC_073

' ==============================================================================
' Veze između slučajeva uporabe
' ==============================================================================

' Provjera sukoba interesa obvezan je dio predlaganja dodjele radova.
UC_074 ..> UC_073 : <<include>>

' ==============================================================================
' Raspored aktera
' ==============================================================================

' Predsjednik se smješta lijevo od sustava.
Chair -[hidden]left- UC_071

' Recenzent se smješta desno od sustava.
UC_081 -[hidden]right- Reviewer

' ORCID se smješta skroz desno od recenzenta.
Reviewer -[hidden]- ORCID

@enduml
